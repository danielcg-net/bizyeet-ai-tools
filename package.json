{
  "name": "@bizyeet/ai-tools",
  "version": "0.0.0-development",
  "private": true,
  "description": "Public CLI and MCP tools for tenant-authorized BizYeet AI agents.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "release:preflight": "npm run build && node dist/scripts/release-candidate.js",
    "release:verify": "npm run build && node dist/scripts/release-artifacts.js",
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/src/*.test.js dist/scripts/*.test.js dist/.github/scripts/validate-youtrack-delivery-policy.test.js",
    "lint": "eslint .",
    "check:workflows": "npm run build && node dist/scripts/check-workflow-security.js",
    "check": "npm run typecheck && npm run lint && npm run test && npm run check:workflows && npm run check:routing && npm run check:docs",
    "check:docs": "npm run build && node dist/scripts/check-documentation.js",
    "check:routing": "npm run build && node dist/scripts/check-canonical-routing.js"
  },
  "bin": {
    "bizyeet": "./dist/src/cli.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "devDependencies": {
    "marked": "18.0.12",
    "@eslint/js": "^10.0.0",
    "@types/node": "^26.4.0",
    "eslint": "^10.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "yaml": "^2.9.0"
  },
  "license": "Apache-2.0"
}
