{
  "name": "@bizyeet/ai-tools",
  "version": "0.0.0-development",
  "private": true,
  "description": "Public CLI and MCP tools for tenant-authorized BizYeet AI agents.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/src/cli.test.js dist/scripts/check-workflow-security.test.js",
    "lint": "eslint .",
    "check:workflows": "npm run build && node dist/scripts/check-workflow-security.js",
    "check": "npm run typecheck && npm run lint && npm run test && npm run check:workflows"
  },
  "bin": {
    "bizyeet": "./dist/src/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "yaml": "^2.9.0"
  },
  "license": "Apache-2.0"
}
